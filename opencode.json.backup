{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "browsermcp": {
            "type": "local",
            "command": ["npx", "@browsermcp/mcp@latest"]
        }
    }
}