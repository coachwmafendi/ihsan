{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-ec1c894b1f59ea33-zy3ii3-2b57220e"
      },
      "models": {
        "oc/auto": {
          "name": "OpenCode Auto"
        },
        "kr/claude-sonnet-4.5": {
          "name": "Kiro Claude Sonnet 4.5"
        }
      }
    },
    "cloudflare-workers-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloudflare Workers AI",
      "options": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/YOUR_CF_ACCOUNT_ID/ai/v1",
        "apiKey": "YOUR_CF_API_TOKEN"
      },
      "models": {
        "@cf/moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6 (CF Workers AI)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true
        }
      }
    }
  },
  "model": "cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6",
  "small_model": "cloudflare-workers-ai/@cf/moonshotai/kimi-k2.6",
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "enabled": true,
      "command": [
        "php",
        "artisan",
        "boost:mcp"
      ]
    },
    "browsermcp": {
      "type": "local",
      "command": ["npx", "@browsermcp/mcp@latest"]
    }
  }
}
